# Base de données PostgreSQL (Neon en production)
DATABASE_URL=

# ── Authentification (NextAuth v5) ──
# Les identifiants de connexion sont stockés EN BASE (table User, hash bcrypt).
# Les comptes se créent désormais depuis /signup, avec un code d'invitation.
AUTH_SECRET=              # généré avec : npx auth secret
AUTH_TRUST_HOST=true      # true en dev et derrière un proxy
NEXTAUTH_URL=http://localhost:3000

# ── Inscription ──
# Codes d'invitation acceptés sur /signup, séparés par des virgules et
# insensibles à la casse. C'est le SEUL verrou entre internet et la création
# d'un compte : la landing est publique. Variable absente = aucune inscription
# possible (fermé par défaut, jamais ouvert par défaut).
INVITE_CODES=FREE

# ── Séparation vitrine / application (facultatif) ──
# Deux hôtes distincts pour la landing et pour l'app. TANT QUE CES DEUX
# VARIABLES SONT ABSENTES, rien ne change : tout est servi sur un seul domaine.
# Une fois renseignées, la vitrine ne sert que « / » et « /legal/* », et tout le
# reste — dont /login et /signup, qui posent le cookie de session — bascule sur
# l'hôte de l'application.
# ⚠️ Un sous-sous-domaine de vercel.app (app.mon-projet.vercel.app) est
#    impossible : le certificat de Vercel ne couvre qu'un seul niveau.
NEXT_PUBLIC_LANDING_HOST=   # ex. myflip.vercel.app
NEXT_PUBLIC_APP_HOST=       # ex. myflip-app.vercel.app

# ── Chiffrement des secrets par utilisateur ──
# Clé maîtresse AES-256-GCM protégeant les clés IA et l'accès Trello que chaque
# utilisateur saisit dans /compte (table UserSettings).
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ La perdre rend TOUS les secrets stockés illisibles, et la changer invalide
#    l'existant. À sauvegarder hors Vercel dès sa génération.
ENCRYPTION_KEY=

# ── IA ──
# Clés de repli de l'application : utilisées pour les comptes qui n'ont pas
# saisi la leur dans /compte. Ce repli n'existe QUE pour l'IA — il n'expose que
# le quota de l'application. Il n'a jamais existé pour Trello depuis le
# 15/08/2026 : y retomber exposerait le board d'un autre utilisateur.
OPENROUTER_API_KEY=       # génération des annonces (page Mise en vente) + chatbot
# GEMINI_API_KEY n'est plus lue depuis le passage à OpenRouter (13/08/2026).
# ANTHROPIC_API_KEY n'est plus lue depuis le passage du chatbot à OpenRouter (15/08/2026).

# ── Emails transactionnels (Resend) ──
RESEND_API_KEY=

# ── Intégration Trello ──
# MyFlip est une APPLICATION Trello : les utilisateurs cliquent sur
# « Connecter Trello » et autorisent MyFlip. Ils ne saisissent jamais de clé.
#
# Les deux valeurs ci-dessous sont celles de l'APPLICATION, pas d'un
# utilisateur. Elles se récupèrent sur https://trello.com/power-ups/admin,
# onglet « API key » du Power-Up : les champs « API key » et « OAuth Secret ».
TRELLO_API_KEY=
TRELLO_API_SECRET=      # signe les requêtes OAuth ET valide la signature des webhooks

# ── Reliquats de l'ancienne configuration (avant le 15/08/2026) ──
# L'application ne les lit plus. `scripts/migrer-trello-env.ts` les lit une
# dernière fois pour recopier la connexion du propriétaire dans son compte ;
# elles peuvent être supprimées du déploiement une fois la migration passée.
# TRELLO_TOKEN=
# TRELLO_SECRET=
# TRELLO_BOARD_ID=
# TRELLO_LABEL_ID=
# TRELLO_COMPTABILISE_LABEL_ID=
# TRELLO_OWNER_EMAIL=           # désigne le compte cible de la migration

# ── Divers ──
# NEXT_PUBLIC_USER_NAME a été retirée : le prénom vit sur User.prenom et
# transite par la session (cf. lib/useIdentite.ts). Une variable inlinée au
# build ne pouvait pas différer d'un compte à l'autre.

# ── API Hermes (agent de sourcing) ──
# Petite API interne, hors session, consommée par l'agent Hermes qui tourne sur
# un serveur tiers. Surface volontairement réduite : créer une commande, changer
# le statut d'articles, relire une commande. Aucune suppression, aucune écriture
# de champ arbitraire — cf. app/api/hermes/.
#
# Sans ces deux variables, /api/hermes/* répond 503 : une configuration
# incomplète doit se voir, jamais se dégrader en accès libre.
HERMES_API_TOKEN=      # secret partagé, ≥32 octets aléatoires : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
HERMES_USER_EMAIL=     # compte MyFlip sur lequel Hermes écrit — l'appelant ne le choisit pas

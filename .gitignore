/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.zip

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# scripts one-shot
scripts/seed-alex.mjs
scripts/init-user.mjs

# État local gstack
.gstack/
.env*

# Worktrees créés par Claude Code : outillage local, pas du projet.
.claude/worktrees/

# Suite e2e Playwright (e2e/README.md) : builds, base, sessions, captures et
# rapports locaux. e2e/rapports/avant/ (petits JSON) reste suivi.
/.next-e2e-*.nosync/
/.e2e-db.nosync/
/e2e/.auth/
/e2e/captures.nosync/
/e2e/rapports/courant*/
/test-results*/
/playwright-report*/
# Captures des pistes de direction rejetées (20/10) et doublons iCloud des rapports.
/docs/refonte/**/*.png
/e2e/rapports/avant/* [0-9].*

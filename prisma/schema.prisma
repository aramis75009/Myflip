// MyFlip – schéma Prisma
// Docs : https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

enum CompteVente {
  VINTED_PRO
  VINTED_SECOND
  VESTIAIRE_COLLECTIVE
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  password       String
  // Prénom affiché dans le dashboard et les paramètres. Remplace la variable
  // d'env NEXT_PUBLIC_USER_NAME, qui était inlinée au build et donc commune à
  // tous les comptes.
  prenom         String?
  // Offre choisie sur la landing. Purement indicatif : aucun quota ni
  // facturation n'est appliqué aujourd'hui (cf. plan, § Dette assumée).
  plan           String?
  resetToken     String?
  resetTokenExp  DateTime?
  createdAt      DateTime  @default(now())

  articles  Article[]
  commandes Commande[]
  lots      Lot[]
  prompts   PromptTemplate[]
  settings  UserSettings?

  // Studio IA — cloisonné du reste (cf. la section en bas de ce fichier).
  // Aucune de ces relations ne touche Article.
  studioColoris    StudioColoris[]
  studioReferences StudioReference[]
  studioAngles     StudioAngle[]
  studioFavoris    StudioModeleFavori[]
  studioEchecs     StudioEchec[]
  studioReglages   StudioReglages?
}

/// Réglages et secrets propres à un compte : clés IA et accès Trello.
///
/// Les secrets sont stockés CHIFFRÉS (AES-256-GCM, cf. `lib/crypto.ts`) et ne
/// ressortent jamais de l'API en clair — seulement un booléen « renseigné » et
/// les 4 derniers caractères. Les identifiants non secrets (ids de board et
/// d'étiquettes) restent en clair : ils servent de critère de recherche.
model UserSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Clés IA, chiffrées. Absentes = on retombe sur la clé d'environnement.
  // ⚠️ `geminiKey` n'est PLUS LUE : la génération passe par OpenRouter depuis le
  // 13/08/2026. `anthropicKey` n'est PLUS LUE non plus : l'assistant passe par
  // OpenRouter depuis le 15/08/2026 (cf. `openrouterKey`). Les deux colonnes
  // sont conservées volontairement — une clé effacée ne se récupère pas, et
  // `prisma db push` proposera de les dropper : refuser.
  geminiKey     String? @db.Text
  anthropicKey  String? @db.Text
  openrouterKey String? @db.Text

  // Accès Trello HÉRITÉ : clé, jeton et secret saisis à la main avant le
  // 15/08/2026. Toujours lus — ils portent les connexions d'avant l'OAuth.
  // ⚠️ Ne pas les dropper tant qu'un compte en dépend, et plus rien ne doit
  // les ÉCRIRE : l'accès s'obtient désormais par /api/trello/connect.
  trelloKey    String? @db.Text
  trelloToken  String? @db.Text
  trelloSecret String? @db.Text

  // ── Connexion OAuth 1.0a (15/08/2026) ──
  // L'utilisateur ne saisit plus de clé : il autorise MyFlip chez Trello.
  // Le jeton est chiffré et ne quitte jamais le serveur.
  trelloOauthToken       String? @db.Text
  trelloOauthTokenSecret String? @db.Text

  // Éphémères : ils ne vivent qu'entre la redirection et le retour de Trello.
  // `trelloOauthRequestToken` est en clair (Trello nous le renvoie dans l'URL),
  // son secret est chiffré. Le rattachement au compte plus `trelloOauthExpire`
  // forment la protection CSRF du parcours.
  trelloOauthRequestToken  String?
  trelloOauthRequestSecret String?   @db.Text
  trelloOauthExpire        DateTime?

  // Identité affichée dans l'écran de configuration.
  trelloMembreId  String?
  trelloMembreNom String?

  // Webhook du board, gardé pour pouvoir le supprimer à la déconnexion.
  trelloWebhookId String?

  // Identifiants Trello en clair. `trelloBoardId` est UNIQUE : c'est la clé de
  // routage du webhook entrant, qui n'a pas de session pour s'identifier.
  // Deux comptes ne peuvent donc pas déclarer le même board.
  trelloBoardId            String? @unique
  trelloLabelId            String?
  trelloComptabiliseLabelId String?

  // Modèle de génération d'annonces (lot 4). Null = modèle par défaut de l'app.
  modeleIA String?

  // Modèle de l'assistant conversationnel (la bulle). Catalogue séparé de
  // modeleIA : l'assistant n'a besoin que de l'appel d'outils, pas d'image ni
  // de JSON forcé — cf. `lib/modelesIA.ts`. Null = modèle par défaut de l'app.
  modeleChatIA String?

  // Objectif de chiffre d'affaires mensuel. Vivait dans le localStorage
  // (`lib/objectif.ts`), donc perdu d'un appareil à l'autre.
  objectifMensuel Float?

  // Avancement du parcours de démarrage (/demarrage). Stocké sur le compte et
  // non dans le navigateur : le parcours doit survivre à un onglet fermé et se
  // reprendre depuis un autre appareil.
  onboardingEtape   Int     @default(1)
  onboardingTermine Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Commande {
  id          String    @id @default(cuid())
  date        DateTime  @default(now())
  fournisseur String
  nbArticles  Int
  // Coût total du lot, frais de livraison INCLUS. En mode détaillé il est
  // calculé depuis les lignes et jamais saisi : c'est ce qui garantit
  // `Σ Article.prixAchat = coutTotal`, dont dépendent toutes les métriques de
  // rentabilité (resteARecuperer, coefActuel, datePointMort…).
  coutTotal   Float
  // Part du coutTotal correspondant au transport. Conservée à part pour
  // pouvoir l'afficher, mais elle est déjà répartie au prorata sur les
  // articles — ne jamais la ré-additionner au coutTotal.
  fraisLivraison Float?
  // LISSE   : coût total ÷ nombre d'articles, le mode historique.
  // DETAILLE: un prix d'achat saisi par article (prix hétérogènes).
  // ⚠️ Hérité. Le mode de saisie est désormais une propriété du LOT, pas de la
  // commande : un même achat peut mêler un lot saisi au forfait et un lot saisi
  // pièce par pièce. Conservé pour les commandes antérieures aux lots.
  modeSaisie  String    @default("LISSE")
  marque      String?
  categorie   String?
  grade       String?
  coefObjectif Float?   @default(2.5)
  lots        Lot[]
  articles    Article[]
  createdAt   DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Un lot d'achat à l'intérieur d'une commande.
///
/// Une commande chez un grossiste contient plusieurs sortes de pièces : 50
/// polos Ralph Lauren et 30 t-shirts Ralph Lauren n'ont ni le même prix
/// d'achat, ni la même série de SKU. Le modèle précédent ne savait représenter
/// cela qu'en créant deux commandes fictives.
///
/// Chaque lot porte son propre mode de saisie : au forfait (quantité + prix
/// global) ou pièce par pièce. Les frais de livraison restent au niveau de la
/// commande et se répartissent au prorata sur toutes les pièces de tous les
/// lots — c'est ce qui maintient `Σ Article.prixAchat = Commande.coutTotal`.
model Lot {
  id         String   @id @default(cuid())
  commandeId String
  commande   Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)

  /// Libellé du lot (« Sacs à dos Nike »). Suggéré depuis catégorie + marque,
  /// éditable. Recopié dans `Article.lot`, qui alimente le filtre du Stock.
  nom        String
  marque     String
  categorie  String
  prefixeSku String

  /// LOT   : quantité + prix global, réparti uniformément dans le lot.
  /// PIECE : un prix saisi par pièce.
  modeSaisie String @default("LOT")
  quantite   Int
  /// Prix du lot HORS frais de livraison.
  prixTotal  Float

  articles  Article[]
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([commandeId])
}

model Article {
  id          String    @id @default(cuid())
  // Le SKU n'est unique QUE dans le périmètre d'un utilisateur : deux comptes
  // doivent pouvoir avoir chacun leur PRL-001. Cf. @@unique([userId, sku]).
  sku         String
  // `marque` = la marque réelle (Adidas, Ralph Lauren…), `categorie` = le type
  // d'article (Short, Polo…). `lot` conserve le libellé du lot d'achat
  // (« Short Adidas ») : c'est lui qui alimente le filtre « Tous les lots ».
  marque      String
  categorie   String
  lot         String?
  grade       String?
  statut      String    @default("En stock")
  prixAchat   Float
  prixVente   Float?
  margeBrute  Float?
  margeNette  Float?
  coefficient Float?
  canal       String?   @default("Vinted")
  dateVente   DateTime?
  // Première mise en ligne (statut « En vente »). Posée une fois par
  // lib/dateMiseEnVente.ts, jamais remise à zéro ; corrigeable à la main.
  dateMiseEnVente DateTime?
  transporteur String?
  trelloCardId String?
  commandeId  String?
  commande    Commande? @relation(fields: [commandeId], references: [id], onDelete: SetNull)
  // Nullable : les articles antérieurs aux lots n'en ont pas, et supprimer un
  // lot ne doit pas emporter les articles déjà vendus qu'il contenait.
  lotId       String?
  lotRef      Lot?      @relation(fields: [lotId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  // Annonce générée (Mise en vente)
  titreAnnonce       String? @db.Text
  descriptionAnnonce String? @db.Text
  motsClesAnnonce    String? @db.Text

  compteVente        CompteVente?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sku])
  @@index([userId])
  @@index([statut])
  @@index([marque])
  @@index([lot])
  @@index([trelloCardId])
  @@index([dateVente])
  @@index([commandeId])
  @@index([lotId])
}

// Prompt personnalisable pour la génération d'annonces.
// Sélection par marque/catégorie (cf. lib/promptSelect), repli sur estDefaut.
model PromptTemplate {
  id        String   @id @default(cuid())
  nom       String
  marque    String? // critère de correspondance ; null = toutes les marques
  categorie String? // critère de correspondance ; null = toutes les catégories
  contenu   String   @db.Text // prompt avec placeholders {marque} {categorie} {taille} {etat} {matiere} {sku}
  estDefaut Boolean  @default(false) // prompt de repli si aucune correspondance
  // Prix pré-rempli dans le QCM de mise en vente ; null = ce prompt n'en porte
  // pas. `Float?` et non `Decimal` : c'est la forme qu'avait PrixReference.prix,
  // et la valeur ne sert qu'à remplir un <input> — elle n'entre dans aucun
  // calcul monétaire.
  prixReference Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // `estDefaut` est un singleton PAR UTILISATEUR, pas global : l'index composite
  // évite un scan de toute la table pour retrouver le défaut d'un compte.
  @@index([userId])
  @@index([userId, estDefaut])
  @@index([marque])
  @@index([categorie])
}

// ─────────────────────────── Studio IA ───────────────────────────
//
// Variantes d'angle d'un sac (spec du 17/10, §8 ; passation du 20/10). Une
// image VALIDÉE par Aramis rejoint l'annonce de son sac cible (`skuCible`), par
// la seule route GET /api/studio/annonce. Rien ici ne référence `Article`, rien
// dans `Article` ne référence ceci, et aucun module de mise en vente, d'export,
// de l'extension ou des API Hermes / SacBase n'importe `lib/studio*` — c'est
// `lib/studioCloisonnement.test.ts` qui le garde.

/// Un coloris suivi par le Studio. `cle` vient de SacBase ("5039-black-pink") :
/// les SKU MyFlip sont des identifiants d'unité, seul SacBase sait quel coloris
/// porte un sac.
model StudioColoris {
  id      String @id @default(cuid())
  cle     String
  modele  String
  coloris String
  /// Détails à préserver, un par ligne. Servent au prompt ET à la grille de
  /// vérification : c'est la même liste des deux côtés, volontairement.
  details String @db.Text @default("")

  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  references StudioReference[]
  essais     StudioEssai[]
  echecs     StudioEchec[]

  @@unique([userId, cle])
  @@index([userId])
}

/// Une VRAIE photo de référence. Jamais une image générée : celles-ci vivent
/// dans `StudioEssai`, et les deux préfixes du Blob sont distincts.
model StudioReference {
  id String @id @default(cuid())
  /// null = pas encore rattachée (SacBase injoignable ou SKU inconnu au
  /// chargement). Rattachée au prochain passage ; ce n'est pas une erreur.
  colorisId String?
  coloris   StudioColoris? @relation(fields: [colorisId], references: [id], onDelete: SetNull)
  /// Sac photographié, quand il est connu. L'import en lot n'en a pas.
  sku      String?
  /// mise_en_vente | studio
  origine  String
  /// face | dos | cote | detail | ouvert
  role     String
  urlImage String
  /// Numéro de la prise (1 à 15) : une ligne du tableau de la fiche. null =
  /// photo gardée mais pas une ligne (conservée à la mise en vente, ancienne).
  ordre    Int?
  /// Nom de la prise (« Face · détail gauche »), cf. PRISES de lib/studioCases.ts.
  prise    String?

  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  essais StudioEssai[]
  echecs StudioEchec[]

  @@index([userId])
  @@index([colorisId])
  @@index([sku])
  @@index([colorisId, ordre])
}

/// Un prompt d'angle, éditable dans /parametres (onglet Studio) : une colonne
/// du tableau de la fiche. Un angle qui a servi ne se supprime pas et ne se
/// réécrit pas : le modifier archive l'ancien et crée une nouvelle version.
model StudioAngle {
  id            String @id @default(cuid())
  /// Nom court : l'en-tête de colonne.
  nom           String
  /// Banc de test (angles archivés) : face | dos | cote | detail | ouvert.
  /// Vide pour les prompts d'angle : la photo jointe est celle de la ligne.
  roleReference String    @default("")
  /// Texte envoyé, après le prompt maître (« Angle: … »).
  angle         String    @db.Text
  ordre         Int       @default(0)
  /// null = actif. Les 7 angles du banc de test sont archivés au 20/10.
  archiveLe     DateTime?

  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  essais StudioEssai[]
  echecs StudioEchec[]

  @@index([userId, ordre])
}

/// Un essai : une image générée, sa note et la décision d'Aramis.
model StudioEssai {
  id        String        @id @default(cuid())
  colorisId String
  coloris   StudioColoris @relation(fields: [colorisId], references: [id], onDelete: Cascade)
  angleId   String
  /// Restrict, pas Cascade : supprimer un modèle d'angle effacerait les mesures
  /// qui sont le but même du test (§11). Un angle qui a servi se garde.
  angle     StudioAngle   @relation(fields: [angleId], references: [id], onDelete: Restrict)
  /// 1er, 2e essai… pour ce triplet coloris × angle × modèle.
  numero    Int
  /// manuel (image faite ailleurs et déposée) | api (générée par OpenRouter).
  source        String  @default("manuel")
  /// Id OpenRouter du modèle (« google/gemini-3-pro-image »), "manuel" pour un
  /// dépôt. NOT NULL : la numérotation est unique par modèle, un NULL la casserait.
  modele        String  @default("manuel")
  /// Estimation au lancement, null si le tarif est inconnu (jamais inventé).
  coutEstimeUsd Float?
  /// `usage.cost` d'OpenRouter, null s'il ne l'a pas renvoyé (jamais compté zéro).
  coutReelUsd   Float?
  /// Durée de l'appel de génération, en millisecondes. null : essai déposé à la
  /// main, ou antérieur à cette colonne (jamais compté zéro).
  dureeMs       Int?
  /// Regroupe les essais d'un même clic « Générer ».
  lancementId   String?
  /// L'essai raté dont celui-ci est la correction.
  essaiParentId String?
  parent        StudioEssai?  @relation("StudioCorrection", fields: [essaiParentId], references: [id], onDelete: SetNull)
  corrections   StudioEssai[] @relation("StudioCorrection")
  promptUtilise String  @db.Text
  urlImage      String
  /// Sortie du contrôle automatique (§6). Aide à la décision, rien de plus.
  verifIA       Json?
  /// valide | rejete | null. C'est CE champ qui alimente les statistiques, pas
  /// `verifIA` : le verdict du modèle n'est qu'une aide.
  decision      String?
  /// La vraie photo de la ligne. Restrict : une photo qui a servi ne se
  /// supprime pas, sa case se déverrouillerait. null pour le banc de test.
  referenceId   String?
  reference     StudioReference? @relation(fields: [referenceId], references: [id], onDelete: Restrict)
  /// Le sac dont l'annonce reçoit l'image une fois validée (« SDN15 »). Pas
  /// de clé étrangère vers Article, comme StudioReference.sku.
  skuCible      String?

  createdAt DateTime @default(now())

  /// Le numéro court par colonne (coloris × angle × modèle), pas par case :
  /// le « premier essai » d'une case est celui sans `essaiParentId`.
  @@unique([colorisId, angleId, modele, numero])
  @@index([colorisId])
  @@index([angleId])
  @@index([referenceId, angleId])
  @@index([skuCible])
}

/// Réglages du Studio, un par compte.
model StudioReglages {
  id           String   @id @default(cuid())
  /// Envoyé une fois en tête de conversation Gemini, placé en tête de chaque
  /// génération par API, suivi du prompt d'angle.
  promptMaitre String   @db.Text @default("")
  /// Budget d'un sac complet (15 prises), en euros. Un lancement estimé au-delà,
  /// ou dont un prix est inconnu, demande confirmation (vérifié côté serveur).
  budgetParSacEur Float @default(1)
  /// Euros pour 1 dollar : OpenRouter facture en dollars, le budget est en euros.
  /// Affiché et réglable ; jamais lu d'un service de change.
  tauxEurParUsd   Float @default(0.86)
  updatedAt    DateTime @default(now()) @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Modèle d'image épinglé par un compte, pour le sélecteur des lignes d'angle.
model StudioModeleFavori {
  id     String @id @default(cuid())
  modele String

  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, modele])
}

/// Une génération par API qui n'a pas produit d'image. Ne consomme aucun
/// numéro d'essai et n'entre dans aucun taux ; se compte à part au bilan.
model StudioEchec {
  id          String        @id @default(cuid())
  colorisId   String
  coloris     StudioColoris @relation(fields: [colorisId], references: [id], onDelete: Cascade)
  angleId     String
  angle       StudioAngle   @relation(fields: [angleId], references: [id], onDelete: Restrict)
  modele      String
  /// Code de `StudioGenerationError` (securite, no_image, no_credits…).
  code        String
  message     String        @db.Text
  lancementId String?
  coutReelUsd Float?
  /// Durée de l'appel avant l'échec, en millisecondes (null si non mesurée).
  dureeMs     Int?
  referenceId String?
  reference   StudioReference? @relation(fields: [referenceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([colorisId])
}
